---
import { Leaf, Award, Heart, Globe2 } from "@lucide/astro";
import { Image } from "astro:assets";

import vichePurita from "../assets/images/viche-purita.webp";

const values = [
  {
    icon: Leaf,
    title: "Ingredientes naturales",
    text: "Elaborado siguiendo técnicas ancestrales transmitidas de generación en generacion por maestros destiladores.",
  },
  {
    icon: Award,
    title: "Calidad garantizada",
    text: "Proceso de destilación controlado para asegurar un producto puro y de la mejor calidad.",
  },
  {
    icon: Globe2,
    title: "Herencia Cultural",
    text: "Cada botella representa el legado y la identidad de las comunidades afrocolombianas",
  },
  {
    icon: Heart,
    title: "Comercio justo",
    text: "Trabajamos directamente con los cultivadores, garantizando precios dignos.",
  },
];
---

<section id="about" class="py-20 sm:py-28 bg-ink-50 max-w-7xl mx-auto">
  <div class="max-w-container mx-auto px-5 sm:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center mb-20">
      <div class="reveal relative order-2 lg:order-1">
        <div
          class="relative rounded-2xl overflow-hidden shadow-2xl shadow-ink-300/40"
        >
          <Image
            src={vichePurita}
            alt="Botella de Viche Purita sobre una mesa."
            class="w-full h-85 sm:h-110 object-cover"
          />
        </div>

        <div
          class="absolute -bottom-6 -right-4 sm:-right-8 bg-white rounded-xl shadow-xl p-5 sm:p-6 border border-ink-100 max-w-50"
        >
          <div class="font-display font-extrabold text-3xl text-primary-600">
            2022
          </div>
          <div class="text-ink-500 text-sm mt-1">
            Año en que inició nuestro emprendimiento de bebidas ancestrales.
          </div>
        </div>

        <div
          class="absolute -top-4 -left-4 w-24 h-24 bg-accent-200/40 rounded-full blur-2xl z-0"
        >
        </div>
      </div>

      <div class="reveal order-1 lg:order-2">
        <span
          class="inline-block text-primary-600 text-sm font-semibold tracking-[0.18em] uppercase mb-4"
        >
          Quiénes Somos
        </span>
        <h2
          class="font-display font-extrabold text-3xl sm:text-4xl lg:text-5xl text-ink-800 leading-[1.18] mb-6"
        >
          Una tradición que trasciende el tiempo
        </h2>
        <p class="text-ink-600 leading-relaxed mb-5">
          Somos guardianes de una tradición centenaria. Desde las riberas del
          Pacífico colombiano, llevamos al mundo el sabor auténtico del viche,
          una bebida que nace del corazón de la caña de azúcar y del alma de
          nuestras comunidades afrodescendientes.
        </p>
        <p class="text-ink-600 leading-relaxed mb-8">
          Cada botella que producimos es un homenaje a nuestros ancestros,
          elaborada con las mismas técnicas artesanales que han pasado de
          generación en generación, preservando la esencia y el espíritu del
          Pacífico.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-5 sm:gap-6">
      {
        values.map((value, i) => {
          const Icon = value.icon;
          return (
            <div
              class="reveal bg-white rounded-xl p-5 sm:p-6 border border-ink-100 hover:border-primary-200 hover:shadow-lg hover:shadow-primary-100/50 transition-all duration-400"
              style={{ transitionDelay: `${i * 80}ms` }}
            >
              <div class="flex items-center justify-center w-11 h-11 rounded-lg bg-primary-50 mb-4">
                <Icon class="w-5 h-5 text-primary-700" />
              </div>
              <h3 class="font-display font-bold text-ink-800 text-base mb-2">
                {value.title}
              </h3>
              <p class="text-ink-500 text-sm leading-relaxed">{value.text}</p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
