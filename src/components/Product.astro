---
import { Plus, Star } from "@lucide/astro";
import { formatCOP, type Product } from "../data/products";
import { Image } from "astro:assets";

type Props = {
  product: Product;
  index: number;
};

const { product, index } = Astro.props;
---

<article
  class="reveal group bg-white rounded-2xl overflow-hidden border border-ink-100 hover:border-primary-200 hover:shadow-2xl hover:shadow-ink-300/30 transition-all duration-500 flex flex-col"
  style={{ transitionDelay: `${index * 90}ms` }}
>
 
  <div class="relative overflow-hidden h-56 sm:h-64 bg-black">
    <Image
      src={product.image}
      alt={product.name}
      class="product-img w-full h-full object-contain"
      loading="lazy"
    />
    {/* Gradient overlay at bottom for readability */}
    <div
      class="absolute inset-0 bg-linear-to-t from-ink-900/30 via-transparent to-transparent"
    >
    </div>


    {
      product.badge && (
        <span class="absolute top-3 left-3 inline-flex items-center gap-1.5 px-3 py-1.5 bg-accent-500/95 backdrop-blur text-white text-xs font-semibold rounded-full shadow-md">
          <Star class="w-3 h-3 fill-white" />
          {product.badge}
        </span>
      )
    }

 
    <span
      data-volume
      class="absolute top-3 right-3 rounded-md border border-white/70 bg-white/95 px-2.5 py-1 text-xs font-semibold text-ink-700 shadow-sm backdrop-blur"
    >
      {product.volume}
    </span>
  </div>


  <div class="flex flex-col flex-1 p-5 sm:p-6">
    <span
      class="text-primary-600 text-xs font-semibold tracking-wider uppercase mb-1.5"
    >
      {product.tagline}
    </span>
    <h3 class="font-display font-bold text-lg text-ink-800 mb-2">
      {product.name}
    </h3>
    <p class="text-ink-500 text-sm leading-relaxed mb-5 flex-1">
      {product.description}
    </p>


    <div
      class="flex items-center justify-between gap-3 pt-4 border-t border-ink-100"
    >
      <div>
        <div class="text-ink-400 text-xs">Precio</div>
        <div class="font-display font-extrabold text-xl text-ink-800">
          {formatCOP(product.price)}
        </div>
      </div>
      <a
        href="https://wa.me/573225682387"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2.5 bg-primary-700 hover:bg-primary-900 text-white text-sm font-semibold rounded-lg shadow-sm hover:shadow-md transition-all duration-300 hover:scale-[1.04] active:scale-95"
      >
        <Plus class="w-4 h-4" />
        Comprar
      </a>
    </div>
  </div>
</article>
