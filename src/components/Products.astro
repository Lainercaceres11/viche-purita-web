---
import { products } from "../data/products";
import { ShoppingBag } from "@lucide/astro";
import Product from "./Product.astro";
---

<section id="products" class="py-20 sm:py-28 bg-white">
  <div class="max-w-container mx-auto px-5 sm:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14 reveal">
      <span
        class="inline-block text-primary-600 text-sm font-semibold tracking-[0.18em] uppercase mb-4"
      >
        Nuestros Productos
      </span>
      <h2
        class="font-display font-extrabold text-3xl sm:text-4xl lg:text-5xl text-ink-800 leading-[1.18] mb-4"
      >
        Bebidas que cuentan historias
      </h2>
      <p class="text-ink-500 leading-relaxed">
        Descubre nuestra colección de bebidas ancestrales. Cada producto es el
        resultado de años de perfeccionamiento y un profundo respeto por la
        tradición.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {products.map((product, i) => <Product product={product} index={i} />)}
    </div>

    <div class="text-center mt-14 reveal">
      <p class="text-ink-500 mb-5">
        ¿Interesado en pedidos al por mayor o distribución?
      </p>
      <a
        href="https://wa.me/573225682387"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 px-7 py-3.5 bg-ink-800 hover:bg-ink-900 text-white font-semibold rounded-xl shadow-lg transition-all duration-300 hover:scale-[1.03] active:scale-95"
      >
        <ShoppingBag class="w-5 h-5" />
        Solicitar catálogo completo
      </a>
    </div>
  </div>
</section>
