---
import { ArrowRight, ShoppingBag, Sparkles } from "@lucide/astro";

import { Image } from "astro:assets";
import banner from "../assets/images/banner.webp";

const scrollTo = (href: string) => {
  document.querySelector(href)?.scrollIntoView({ behavior: "smooth" });
};
---

<section
  id="hero"
  class="relative min-h-screen flex items-center justify-center overflow-hidden"
>
  <div class="absolute inset-0 z-0">
    <img
      src={banner.src}
      alt="Botella de bebida artesanal con humo dramático"
      class="hero-media w-full h-full object-cover"
    />
    <div class="absolute inset-0 hero-overlay"></div>
  </div>

  <div class="relative z-10 max-w-container w-full px-5 sm:px-8 pt-24 pb-16">
    <div class="max-w-2xl">
      {/* Heading */}
      <h1
        class="font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl text-white leading-[1.12] mb-6 animate-fade-up"
      >
        El sabor ancestral del{" "}
        <span class="hero-accent">Pacífico colombiano</span>
      </h1>


      <p
        class="text-white/80 text-base sm:text-lg leading-relaxed max-w-xl mb-10 animate-fade-in-delayed"
      >
        Bebidas artesanales elaboradas con saberes transmitidos por
        generaciones. Cada botella contiene la historia, la tierra y el espíritu
        de nuestras raíces.
      </p>


      <div class="flex flex-col sm:flex-row gap-4 animate-fade-in-delayed">
        <a
          href="#products"
          class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 bg-primary-700 hover:bg-primary-900 text-white font-semibold rounded-xl shadow-lg shadow-primary-900/30 transition-all duration-300 hover:scale-[1.03] active:scale-95"
        >
          <ShoppingBag class="w-5 h-5" />
          Ver productos
        </a>
        <a
          href="#contact"
          class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 bg-white/10 backdrop-blur-md border border-white/25 hover:bg-white/20 text-white font-semibold rounded-xl transition-all duration-300 hover:scale-[1.03] active:scale-95"
        >
          Contáctanos
          <ArrowRight class="w-5 h-5" />
        </a>
      </div>
    </div>
  </div>


  <div
    class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 hidden sm:block animate-float"
  >
    <div class="flex flex-col items-center gap-2 text-white/50">
      <span class="text-[10px] tracking-[0.2em] uppercase">Explorar</span>
      <div class="w-px h-10 bg-linear-to-b from-white/40 to-transparent"></div>
    </div>
  </div>
</section>
