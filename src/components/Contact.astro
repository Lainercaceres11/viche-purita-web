---
import {
  MapPin,
  Phone,
  Mail,
  Clock,
} from "@lucide/astro";

const contactInfo = [
  {
    icon: MapPin,
    label: "Dirección",
    value: "Quibdó, Chocó, Colombia",
  },
  { icon: Phone, label: "Teléfono", value: "3225682387" },
  { icon: Mail, label: "Email", value: "adelinasalaspotes@gmail.com" },
  { icon: Clock, label: "Horario", value: "Lun a Sáb: 8:00 AM — 6:00 PM" },
];
---

<section id="contact" class="py-20 sm:py-28 bg-ink-50">
  <div class="max-w-container mx-auto px-5 sm:px-8">
 
    <div class="text-center max-w-2xl mx-auto mb-14 reveal">
      <span
        class="inline-block text-primary-600 text-sm font-semibold tracking-[0.18em] uppercase mb-4"
      >
        Contáctanos
      </span>
      <h2
        class="font-display font-extrabold text-3xl sm:text-4xl lg:text-5xl text-ink-800 leading-[1.18] mb-4"
      >
        Estamos para servirte
      </h2>
      <p class="text-ink-500 leading-relaxed">
        ¿Tienes preguntas sobre nuestros productos o quieres realizar un pedido?
        Escríbenos y te responderemos lo antes posible.
      </p>
    </div>

    <div class="grid lg:grid-cols-5 gap-8 lg:gap-12">
   
      <div class="lg:col-span-3 reveal">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3979.882187091168!2d-76.6581559247696!3d5.694905996042024!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e4e7c8b8b8b8b8b%3A0x8e4e7c8b8b8b8b8b!2sQuibd%C3%B3%2C%20Choc%C3%B3%2C%20Colombia!5e0!3m2!1sen!2sus!4v1697040000000"
          width="100%"
          height="400"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="mt-6 rounded-2xl border border-ink-100 shadow-lg shadow-ink-200/40"
        ></iframe>
      </div>

   
      <div class="lg:col-span-2 flex flex-col gap-6 reveal">
        {/* Contact info card */}
        <div
          class="bg-white rounded-2xl shadow-lg shadow-ink-200/40 p-6 sm:p-8 border border-ink-100"
        >
          <h3 class="font-display font-bold text-xl text-ink-800 mb-6">
            Información de contacto
          </h3>
          <ul class="flex flex-col gap-5">
            {
              contactInfo.map((item) => {
                const Icon = item.icon;
                return (
                  <li class="flex items-start gap-4">
                    <span class="flex items-center justify-center w-10 h-10 rounded-lg bg-primary-50 shrink-0">
                      <Icon class="w-5 h-5 text-primary-700" />
                    </span>
                    <div>
                      <div class="text-ink-400 text-xs uppercase tracking-wider font-medium">
                        {item.label}
                      </div>
                      <div class="text-ink-700 text-sm font-medium mt-0.5">
                        {item.value}
                      </div>
                    </div>
                  </li>
                );
              })
            }
          </ul>
        </div>

 
        <div
          class="bg-white rounded-2xl shadow-lg shadow-ink-200/40 overflow-hidden border border-ink-100 flex-1 min-h-55 relative"
        >
          <div
            class="relative w-full h-full min-h-55 bg-linear-to-br from-secondary-50 via-ink-50 to-primary-50 flex items-center justify-center"
          >
            {/* Decorative grid lines simulating map */}
            <div
              class="absolute inset-0 opacity-30"
              style={{
                backgroundImage:
                  "linear-gradient(rgba(0,0,0,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,0.04) 1px, transparent 1px)",
                backgroundSize: "40px 40px",
              }}
            >
            </div>
         
            <div
              class="absolute top-1/3 left-0 right-0 h-1.5 bg-ink-200/50 rounded-full"
            >
            </div>
            <div
              class="absolute top-0 bottom-0 left-1/3 w-1.5 bg-ink-200/50 rounded-full"
            >
            </div>
            <div
              class="absolute top-1/2 left-0 w-2/3 h-1 bg-ink-200/40 rounded-full rotate-12"
            >
            </div>

       
            <div class="relative flex flex-col items-center">
              <div
                class="absolute -top-16 w-12 h-12 bg-primary-600/20 rounded-full animate-ping"
              >
              </div>
              <div
                class="flex items-center justify-center w-12 h-12 bg-primary-600 rounded-full shadow-lg shadow-primary-600/40 border-4 border-white"
              >
                <MapPin class="w-5 h-5 text-white" />
              </div>
              <div
                class="mt-3 bg-white px-4 py-2 rounded-lg shadow-md text-center"
              >
                <div class="text-ink-800 text-sm font-semibold">
                  Quibdó, Chocó
                </div>
                <div class="text-ink-400 text-xs">Colombia</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
